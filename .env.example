# Supabase (clave pública/anónima — solo lectura de carta y canales tiempo real)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_publica

# Supabase service_role (SOLO servidor, nunca al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Webhook de n8n que valida y crea pedidos
N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/pedidos-nuevo

# URL base de la app (para redirect de Stripe Checkout)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Token de acceso al panel de administración (/admin)
ADMIN_TOKEN=un_token_secreto_largo_que_solo_el_personal_conozca

# (Opcional) Expuesto al frontend solo para saber si el panel está activo
NEXT_PUBLIC_ADMIN_TOKEN=un_token_secreto_largo_que_solo_el_personal_conozca

# Horario de apertura (HH:MM, 24h) — n8n lo lee para rechazar fuera de horario
APERTURA_HORA=08
APERTURA_MINUTO=00
CIERRE_HORA=20
CIERRE_MINUTO=00
CIERRE_RESTRINGIDO_MINUTOS=15
